{
  "info": {
    "name": "STR Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete Postman collection for the STR Platform API v1.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.strplatform.com/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" },
    { "key": "offerId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.test('Has accessToken', () => pm.expect(json.accessToken).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"Str0ng!Pass\",\"name\":\"Test User\",\"role\":\"customer\"}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"Str0ng!Pass\"}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Updated Name\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Estimate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has estimateId', () => pm.expect(json.estimateId).to.be.a('string'));",
                  "pm.test('Has price', () => pm.expect(json.estimatedPrice).to.be.a('number'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/estimate",
            "body": {
              "mode": "raw",
              "raw": "{\"imageUrls\":[\"https://s3.strplatform.com/test/pile.jpg\"],\"address\":\"123 Elm St, Austin TX\"}"
            }
          }
        },
        {
          "name": "List Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "if (json.data.length > 0) {",
                  "  pm.collectionVariables.set('jobId', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=10",
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Get Job",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        }
      ]
    },
    {
      "name": "Offers",
      "item": [
        {
          "name": "List Active Offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Is array', () => pm.expect(json).to.be.an('array'));",
                  "if (json.length > 0) {",
                  "  pm.collectionVariables.set('offerId', json[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/offers/active"
          }
        },
        {
          "name": "Accept Offer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/offers/{{offerId}}/accept"
          }
        },
        {
          "name": "Decline Offer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/offers/{{offerId}}/decline"
          }
        }
      ]
    },
    {
      "name": "Tracking",
      "item": [
        {
          "name": "Get Tracking Snapshot",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tracking/{{jobId}}"
          }
        },
        {
          "name": "Update Courier Location",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tracking/{{jobId}}/location",
            "body": {
              "mode": "raw",
              "raw": "{\"lat\":30.2652,\"lng\":-97.7415,\"heading\":90,\"speed\":40}"
            }
          }
        }
      ]
    },
    {
      "name": "Ledger",
      "item": [
        {
          "name": "Get Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has available', () => pm.expect(json.available).to.be.a('number'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ledger/balance"
          }
        },
        {
          "name": "List Entries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ledger/entries?limit=20"
          }
        }
      ]
    },
    {
      "name": "Academy",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/academy/courses"
          }
        },
        {
          "name": "Get Badges",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/academy/badges"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Platform Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/analytics/overview"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users?limit=50"
          }
        },
        {
          "name": "List All Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/jobs"
          }
        }
      ]
    }
  ]
}
