[Unit]
Description=STR Platform FastAPI Backend Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/str-platform/apps/api
ExecStart=/usr/local/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
